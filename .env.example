# TingFengBot 环境变量配置文件
# 复制此文件为 .env 并填入实际值

# NoneBot 配置
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
SUPERUSERS=["你的QQ号"]
COMMAND_START=["", "/"]
COMMAND_SEP=["."]

# OneBot V11 连接配置
ONEBOT_WS_URL=ws://your-go-cqhttp-host:8080
ONEBOT_ACCESS_TOKEN=your-access-token-here

# OpenAI API 配置
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=120

# 数据库配置
DB_PATH=/app/data/tingfengbot.db
CHROMA_DB_PATH=/app/data/chroma

# 日志配置
LOG_DIR=/app/logs
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# 性能配置
MAX_CONCURRENT_TASKS=10
MAX_CONSOLIDATION_CONCURRENT=3
MESSAGE_RATE_LIMIT=50
MESSAGE_RATE_WINDOW=10

# 安全配置
ENABLE_INPUT_VALIDATION=true
ENABLE_RATE_LIMITING=true
MAX_MESSAGE_LENGTH=5000

# 机器人配置（可选，也可以使用 config.yaml）
BOT_NAME=听风
BOT_ROLE=AI助手
INITIAL_MOOD=0.5

# Docker 配置
TZ=Asia/Shanghai
PUID=1000
PGID=1000
