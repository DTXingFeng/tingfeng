# Environment variables for OneBot configuration
# Copy this file to .env and adjust values as needed

DRIVER=~websockets
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=DEBUG
ONEBOT_WS_URLS='["ws://127.0.0.1:3001"]'
ONEBOT_ACCESS_TOKEN=             # 可选：如果你的 OneBot 实现（如 LLOneBot/Lagrange）设置了 token，请在此填写

# AI configuration (separate file ai_config.yaml)
# Bot configuration (separate file config.yaml)